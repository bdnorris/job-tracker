---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import printCssUrl from '../styles/print.css?url';
import config from '../config';

interface Props {
  title?: string;
  showNav?: boolean;
}

const { title, showNav = true } = Astro.props;
const pageTitle = title ? `${title} · ${config.app.name}` : config.app.name;
const currentPath = Astro.url.pathname;
const printClass = config.print.showUrls ? 'show-urls' : '';

// Category ids are validated as CSS-safe and colors as hex in the config schema.
// `.hl-hide-<id>` on a container hides that category's marks (the highlighter's filter toggles);
// a hidden inner mark lets an enclosing highlight's color show through.
const highlightCss = config.highlights.categories
  .map((c) => `.hl-${c.id}{--hl-bg:${c.color}}.hl-hide-${c.id} mark.hl-${c.id}{--hl-bg:transparent}`)
  .join('');

const navItems = [
  { href: '/', label: 'Board', active: currentPath === '/' },
  { href: '/jobs', label: 'List', active: currentPath === '/jobs' },
  { href: '/jobs/new', label: 'Add Job', active: currentPath === '/jobs/new', add: true },
  { href: '/profile', label: 'App Kit', active: currentPath.startsWith('/profile') },
  { href: '/settings', label: 'Settings', active: currentPath.startsWith('/settings') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Single-user job tracking board" />
    <meta name="theme-color" content="#0b0d10" />
    <title>{pageTitle}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='3' fill='%230b0d10'/%3E%3Crect x='7' y='8' width='18' height='3' fill='%23f4f5f6'/%3E%3Crect x='7' y='14.5' width='18' height='3' fill='%23ffd400'/%3E%3Crect x='7' y='21' width='12' height='3' fill='%23f4f5f6'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href={printCssUrl} media="print" />
    <style is:inline set:html={highlightCss}></style>
    <slot name="head" />
  </head>
  <body class={printClass}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    {showNav && (
      <header class="app-header no-print">
        <div class="header-inner">
          <a href="/" class="brand-link">
            <svg class="brand-mark" viewBox="0 0 20 20" aria-hidden="true">
              <rect x="0" y="2" width="20" height="3" />
              <rect x="0" y="8.5" width="20" height="3" class="brand-mark-now" />
              <rect x="0" y="15" width="13" height="3" />
            </svg>
            <span class="brand-name">{config.app.name}</span>
          </a>

          <nav class="main-nav" aria-label="Main Navigation">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={[{ active: item.active, 'nav-add': item.add }]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.add && (
                  <svg viewBox="0 0 12 12" aria-hidden="true" class="nav-add-icon">
                    <path d="M6 1v10M1 6h10" />
                  </svg>
                )}
                {item.label}
              </a>
            ))}
          </nav>

          <form action="/api/auth/logout" method="POST" class="header-actions">
            <button type="submit" class="signout">Sign Out</button>
          </form>
        </div>
      </header>
    )}

    <main id="main-content">
      <slot name="band" />
      <div class="main-container">
        <slot />
      </div>
    </main>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -100px;
        z-index: 100;
        padding: 0.5rem 0.9rem;
        background: var(--alert);
        color: var(--alert-ink);
        font-weight: 600;
        border-radius: var(--radius-md);
      }
      .skip-link:focus {
        top: 0.5rem;
      }
      .app-header {
        --focus: var(--alert);
        background-color: var(--shell-bg);
        color: var(--shell-text);
        border-bottom: 1px solid var(--shell-line);
        height: var(--header-height);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 2rem;
      }
      .brand-link {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--shell-text);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand-link:hover {
        text-decoration: none;
      }
      .brand-mark {
        width: 18px;
        height: 18px;
        fill: var(--shell-text);
      }
      .brand-mark .brand-mark-now {
        fill: var(--alert);
      }
      .brand-name {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .main-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex: 1;
      }
      .main-nav a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--shell-muted);
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .main-nav a:hover {
        background-color: var(--shell-raised);
        color: var(--shell-text);
      }
      .main-nav a.active {
        background-color: var(--shell-text);
        color: var(--shell-bg);
      }
      .main-nav a.nav-add {
        margin-left: 0.5rem;
        border: 1px solid var(--shell-line);
        color: var(--shell-text);
      }
      .main-nav a.nav-add.active {
        border-color: var(--shell-text);
        color: var(--shell-bg);
      }
      .nav-add-icon {
        width: 11px;
        height: 11px;
        stroke: currentColor;
        stroke-width: 1.75;
        fill: none;
      }
      .signout {
        background: none;
        border: 1px solid transparent;
        border-radius: var(--radius-md);
        padding: 0.35rem 0.6rem;
        color: var(--shell-muted);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        white-space: nowrap;
      }
      .signout:hover {
        color: var(--shell-text);
        border-color: var(--shell-line);
      }
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .main-container {
        flex: 1;
        max-width: var(--max-width);
        width: 100%;
        margin: 0 auto;
        padding: 1.5rem;
      }
      @media (max-width: 860px) {
        .app-header {
          height: auto;
        }
        .header-inner {
          flex-wrap: wrap;
          gap: 0.25rem 0.75rem;
          padding: 0.6rem 1rem 0.4rem;
        }
        .header-actions {
          margin-left: auto;
        }
        .main-nav {
          order: 3;
          flex-basis: 100%;
          overflow-x: auto;
          gap: 0.125rem;
          margin: 0 -0.5rem;
          padding-bottom: 0.2rem;
        }
        .main-nav a {
          padding: 0.4rem 0.6rem;
        }
        .main-nav a.nav-add {
          margin-left: 0.25rem;
        }
        .main-container {
          padding: 1rem;
        }
      }
    </style>
  </body>
</html>
