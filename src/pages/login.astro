---
import Layout from '../layouts/Layout.astro';
import config from '../config';

const next = Astro.url.searchParams.get('next') || '/';
const error = Astro.url.searchParams.get('error');
---

<Layout title="Sign In" showNav={false}>
  <div class="login-container">
    <div class="card login-card">
      <div class="login-header">
        <h1>{config.app.name}</h1>
        <p class="subtitle">Enter your password to continue</p>
      </div>

      {error && (
        <div class="error-banner" role="alert">
          {error}
        </div>
      )}

      <form action="/api/auth/login" method="POST" class="login-form">
        <input type="hidden" name="next" value={next} />

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="input"
            required
            autofocus
            autocomplete="current-password"
            placeholder="••••••••"
          />
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          Sign In
        </button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .login-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
  }
  .login-card {
    max-width: 400px;
    width: 100%;
    padding: 2rem;
  }
  .login-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .login-header h1 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }
  .error-banner {
    background-color: var(--danger-subtle);
    border: 1px solid var(--danger-border);
    color: var(--danger);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .btn-block {
    width: 100%;
    padding: 0.625rem;
    font-size: 0.9375rem;
  }
</style>
