---
import Layout from '../layouts/Layout.astro';
import Board, { type BoardJob } from '../components/Board';
import DashboardStrip from '../components/DashboardStrip.astro';
import config from '../config';
import { listJobs, getDashboardStats } from '../db/queries/jobs';
import { computeMatchScore, isSkillMatched } from '../lib/skills/match';
import { formatSalary, REMOTE_LABELS } from '../lib/format';
import { formatDate } from '../lib/dates';

const [jobs, stats] = await Promise.all([listJobs({ includeArchived: false }), getDashboardStats()]);
const today = stats.today;
const stageIds = new Set(config.pipeline.stages.map((s) => s.id));

const boardJobs: BoardJob[] = jobs
  // Jobs whose status was removed from config can't be placed on the board; they remain in the list view.
  .filter((job) => stageIds.has(job.status))
  .map((job) => {
    const skills = job.skills.map((s) => ({ name: s.name, matched: isSkillMatched(s.name) }));
    const topSkills = [...skills.filter((s) => s.matched), ...skills.filter((s) => !s.matched)].slice(0, 3);
    return {
      id: job.id,
      title: job.title,
      company: job.company,
      status: job.status,
      boardOrder: job.boardOrder,
      salary: formatSalary(job),
      remoteLabel: REMOTE_LABELS[job.remoteType] ?? job.remoteType,
      topSkills,
      matchScore: computeMatchScore(job.skills),
      nextAction: job.nextAction,
      nextActionDate: job.nextActionDate,
      nextActionLabel: job.nextActionDate ? formatDate(job.nextActionDate) : null,
      overdue: !!job.nextActionDate && job.nextActionDate < today,
      dueToday: job.nextActionDate === today,
    };
  });

const activeCount = boardJobs.filter(
  (j) => !config.pipeline.stages.find((s) => s.id === j.status)?.closed
).length;
---

<Layout title="Board">
  <div class="board-page">
    <div class="board-header">
      <div>
        <h1>Job Pipeline</h1>
        <p class="subtitle">{activeCount} active job{activeCount === 1 ? '' : 's'}</p>
      </div>
      <div class="header-actions">
        <a href="/jobs" class="btn">List view</a>
        <a href="/jobs/new" class="btn btn-primary">+ Add Job</a>
      </div>
    </div>

    <DashboardStrip stats={stats} />

    <Board client:load stages={config.pipeline.stages} jobs={boardJobs} />
  </div>
</Layout>

<style>
  .board-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .board-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .board-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }
  .header-actions {
    display: flex;
    gap: 0.5rem;
  }
</style>
