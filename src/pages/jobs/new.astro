---
import Layout from '../../layouts/Layout.astro';
import config from '../../config';

const error = Astro.url.searchParams.get('error');
const defaultStage = config.pipeline.defaultStage || 'saved';
---

<Layout title="Add Job">
  <div class="page-container">
    <div class="page-header">
      <div>
        <a href="/jobs" class="back-link">← Back to jobs</a>
        <h1>Add New Job</h1>
      </div>
    </div>

    {error && (
      <div class="error-banner" role="alert">
        {error}
      </div>
    )}

    <form action="/api/jobs" method="POST" class="card job-form">
      <div class="form-grid">
        <!-- Title -->
        <div class="form-group col-span-2">
          <label for="title">Job Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" class="input" required placeholder="e.g. Senior Frontend Engineer" />
        </div>

        <!-- Company -->
        <div class="form-group col-span-2">
          <label for="company">Company <span class="required">*</span></label>
          <input type="text" id="company" name="company" class="input" required placeholder="e.g. Acme Corp" />
        </div>

        <!-- Location -->
        <div class="form-group">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" class="input" placeholder="e.g. Chicago, IL or Remote" />
        </div>

        <!-- Remote Type -->
        <div class="form-group">
          <label for="remoteType">Workplace Type</label>
          <select id="remoteType" name="remoteType" class="select">
            <option value="unknown">Unknown</option>
            <option value="remote">Remote</option>
            <option value="hybrid">Hybrid</option>
            <option value="onsite">Onsite</option>
          </select>
        </div>

        <!-- Salary Min / Max / Period -->
        <div class="form-group">
          <label for="salaryMin">Salary Min ({config.app.currency})</label>
          <input type="number" id="salaryMin" name="salaryMin" class="input" placeholder="120000" min="0" step="1" />
        </div>

        <div class="form-group">
          <label for="salaryMax">Salary Max ({config.app.currency})</label>
          <input type="number" id="salaryMax" name="salaryMax" class="input" placeholder="160000" min="0" step="1" />
        </div>

        <div class="form-group">
          <label for="salaryPeriod">Salary Period</label>
          <select id="salaryPeriod" name="salaryPeriod" class="select">
            <option value="year">Yearly</option>
            <option value="month">Monthly</option>
            <option value="hour">Hourly</option>
          </select>
        </div>

        <div class="form-group">
          <label for="status">Initial Stage</label>
          <select id="status" name="status" class="select">
            {config.pipeline.stages.map((stage) => (
              <option value={stage.id} selected={stage.id === defaultStage}>
                {stage.label}
              </option>
            ))}
          </select>
        </div>

        <!-- Priority -->
        <div class="form-group">
          <label for="priority">Priority</label>
          <select id="priority" name="priority" class="select">
            <option value="0">0 - Low</option>
            <option value="1" selected>1 - Normal</option>
            <option value="2">2 - High</option>
            <option value="3">3 - Urgent</option>
          </select>
        </div>

        <!-- Next Action -->
        <div class="form-group">
          <label for="nextAction">Next Action</label>
          <input type="text" id="nextAction" name="nextAction" class="input" placeholder="e.g. Follow up with recruiter" />
        </div>

        <!-- Next Action Date -->
        <div class="form-group">
          <label for="nextActionDate">Next Action Date</label>
          <input type="date" id="nextActionDate" name="nextActionDate" class="input" />
        </div>

        <!-- Posting URL -->
        <div class="form-group col-span-2">
          <label for="url">Job Posting URL</label>
          <input type="url" id="url" name="url" class="input" placeholder="https://example.com/jobs/123" />
        </div>

        <!-- Skills -->
        <div class="form-group col-span-2">
          <label for="skills">Skills (comma separated)</label>
          <input type="text" id="skills" name="skills" class="input" placeholder="TypeScript, React, Node.js" />
        </div>

        <!-- Description -->
        <div class="form-group col-span-2">
          <label for="descriptionText">Job Description</label>
          <textarea id="descriptionText" name="descriptionText" class="textarea" rows="8" placeholder="Paste or type job description here..."></textarea>
        </div>
      </div>

      <div class="form-actions">
        <a href="/jobs" class="btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Job</button>
      </div>
    </form>
  </div>
</Layout>

<style>
  .page-container {
    max-width: 800px;
    margin: 0 auto;
  }
  .page-header {
    margin-bottom: 1.5rem;
  }
  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }
  .error-banner {
    background-color: var(--danger-subtle);
    border: 1px solid var(--danger-border);
    color: var(--danger);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .col-span-2 {
    grid-column: span 2;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .required {
    color: var(--danger);
  }
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }
  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .col-span-2 {
      grid-column: span 1;
    }
  }
</style>
