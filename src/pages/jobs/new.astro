---
import Layout from '../../layouts/Layout.astro';
import AddJob from '../../components/AddJob';
import config from '../../config';
import { EXTRACTORS } from '../../lib/extract/registry';

const error = Astro.url.searchParams.get('error');
const aiEnabled = config.scraper.order.includes('ai') && EXTRACTORS.ai.enabled();
---

<Layout title="Add Job">
  <div class="page-container">
    <div class="page-header">
      <a href="/jobs" class="back-link">← Back to jobs</a>
      <h1>Add a job</h1>
    </div>
    <noscript>
      <p class="noscript-note">Importing from a URL or pasted text needs JavaScript. You can still fill in the form below.</p>
    </noscript>
    <AddJob
      client:load
      stages={config.pipeline.stages.map((s) => ({ id: s.id, label: s.label }))}
      defaultStage={config.pipeline.defaultStage}
      currency={config.app.currency}
      aiEnabled={aiEnabled}
      error={error}
    />
  </div>
</Layout>

<style>
  .page-container {
    max-width: 800px;
    margin: 0 auto;
  }
  .page-header {
    margin-bottom: 1.25rem;
  }
  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .noscript-note {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }
</style>
