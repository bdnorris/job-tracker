---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import config from '../../config';
import { listJobs, listSkillNames } from '../../db/queries/jobs';
import { computeMatchScore } from '../../lib/skills/match';
import { parseSort, sortJobs, DEFAULT_DIR, type SortKey } from '../../lib/jobs/sort';
import { formatSalary, REMOTE_LABELS } from '../../lib/format';
import { formatDate, todayInTz } from '../../lib/dates';

const url = Astro.url;
const status = url.searchParams.get('status') || '';
const remoteType = url.searchParams.get('remoteType') || '';
const salaryMinStr = url.searchParams.get('salaryMin') || '';
const search = url.searchParams.get('search') || '';
const skill = url.searchParams.get('skill') || '';
const hasOverdueAction = url.searchParams.get('hasOverdueAction') === 'true';
const includeArchived = url.searchParams.get('includeArchived') === 'true';
const { sort, dir } = parseSort(url.searchParams.get('sort'), url.searchParams.get('dir'));

const today = todayInTz();
const closedStageIds = new Set(config.pipeline.stages.filter((s) => s.closed).map((s) => s.id));
const salaryMin = salaryMinStr ? parseInt(salaryMinStr, 10) : undefined;

const [rows, skillNames] = await Promise.all([
  listJobs({
    status: status || undefined,
    remoteType: remoteType || undefined,
    salaryMin: Number.isFinite(salaryMin) ? salaryMin : undefined,
    search: search || undefined,
    skill: skill || undefined,
    hasOverdueAction,
    includeArchived,
  }),
  listSkillNames(),
]);

const jobs = sortJobs(
  rows.map((j) => ({ ...j, matchScore: computeMatchScore(j.skills) })),
  sort,
  dir,
  config.pipeline.stages.map((s) => s.id)
);

const stagesMap = new Map(config.pipeline.stages.map((s) => [s.id, s.label]));

/** Link for a sortable column header: toggles direction if already sorted by it, keeps other filters. */
function sortHref(key: SortKey) {
  const params = new URLSearchParams(url.searchParams);
  const nextDir = sort === key ? (dir === 'asc' ? 'desc' : 'asc') : DEFAULT_DIR[key];
  params.set('sort', key);
  params.set('dir', nextDir);
  return `/jobs?${params.toString()}`;
}

function ariaSort(key: SortKey) {
  if (sort !== key) return undefined;
  return dir === 'asc' ? 'ascending' : 'descending';
}

const columns: { key: SortKey; label: string }[] = [
  { key: 'title', label: 'Title & Company' },
  { key: 'status', label: 'Stage' },
  { key: 'salary', label: 'Salary' },
  { key: 'match', label: 'Match' },
  { key: 'next', label: 'Next Action' },
  { key: 'updated', label: 'Updated' },
];
---

<Layout title="Jobs List">
  <div class="jobs-page">
    <div class="header-row">
      <div>
        <h1>All Jobs</h1>
        <p class="subtitle">Showing {jobs.length} job{jobs.length === 1 ? '' : 's'}</p>
      </div>
      <a href="/jobs/new" class="btn btn-primary"><Icon name="plus" /> Add Job</a>
    </div>

    <!-- Filters Bar -->
    <form method="GET" action="/jobs" class="card filter-bar">
      <div class="filter-inputs">
        <div class="filter-field">
          <label for="search">Search</label>
          <input
            type="text"
            id="search"
            name="search"
            class="input"
            placeholder="Title, company, or keywords"
            value={search}
          />
        </div>

        <div class="filter-field">
          <label for="status">Stage</label>
          <select id="status" name="status" class="select">
            <option value="">All Stages</option>
            {config.pipeline.stages.map((stage) => (
              <option value={stage.id} selected={status === stage.id}>
                {stage.label}
              </option>
            ))}
          </select>
        </div>

        <div class="filter-field">
          <label for="remoteType">Workplace</label>
          <select id="remoteType" name="remoteType" class="select">
            <option value="">All Workplace Types</option>
            <option value="remote" selected={remoteType === 'remote'}>Remote</option>
            <option value="hybrid" selected={remoteType === 'hybrid'}>Hybrid</option>
            <option value="onsite" selected={remoteType === 'onsite'}>Onsite</option>
          </select>
        </div>

        <div class="filter-field">
          <label for="skill">Skill</label>
          <select id="skill" name="skill" class="select">
            <option value="">Any Skill</option>
            {skillNames.map((name) => (
              <option value={name} selected={skill.toLowerCase() === name.toLowerCase()}>
                {name}
              </option>
            ))}
          </select>
        </div>

        <div class="filter-field">
          <label for="salaryMin">Min Salary ({config.app.currency})</label>
          <input
            type="number"
            id="salaryMin"
            name="salaryMin"
            class="input"
            placeholder="e.g. 100000"
            value={salaryMinStr}
          />
        </div>

        <div class="filter-checkboxes">
          <label class="checkbox-label">
            <input type="checkbox" name="hasOverdueAction" value="true" checked={hasOverdueAction} />
            <span>Overdue Next Action</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="includeArchived" value="true" checked={includeArchived} />
            <span>Include Archived</span>
          </label>
        </div>
      </div>

      <input type="hidden" name="sort" value={sort} />
      <input type="hidden" name="dir" value={dir} />
      <div class="filter-actions">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/jobs" class="btn btn-sm">Clear</a>
      </div>
    </form>

    <!-- Table -->
    {jobs.length === 0 ? (
      <div class="card empty-container">
        <p>No jobs found matching your filters.</p>
        <a href="/jobs/new" class="btn btn-primary btn-sm"><Icon name="plus" /> Add your first job</a>
      </div>
    ) : (
      <div class="card table-container">
        <table class="jobs-table">
          <thead>
            <tr>
              {columns.map((col, i) => (
                <>
                  <th scope="col" aria-sort={ariaSort(col.key)}>
                    <a href={sortHref(col.key)} class={`sort-link ${sort === col.key ? 'is-sorted' : ''}`}>
                      {col.label}
                      <span class="sort-indicator" aria-hidden="true">
                        {sort === col.key && <Icon name={dir === 'asc' ? 'sort-asc' : 'sort-desc'} />}
                      </span>
                    </a>
                  </th>
                  {i === 1 && <th scope="col">Workplace</th>}
                </>
              ))}
              <th scope="col" class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {jobs.map((job) => {
              const matchScore = job.matchScore;
              const isOverdue = job.nextActionDate && job.nextActionDate < today;
              const salaryFmt = formatSalary(job, { withCurrency: false }) || '—';

              return (
                <tr class={job.archivedAt ? 'archived-row' : ''}>
                  <td>
                    <div class="job-cell-title">
                      <a href={`/jobs/${job.id}`} class="title-link">
                        {job.title}
                      </a>
                      <span class="company-sub">{job.company}</span>
                      {job.location && <span class="location-sub">{job.location}</span>}
                    </div>
                  </td>
                  <td>
                    <span class:list={['badge stage-badge', { 'is-closed': closedStageIds.has(job.status) }]}>
                      {stagesMap.get(job.status) || job.status}
                    </span>
                  </td>
                  <td>
                    <span class="badge remote-badge">{REMOTE_LABELS[job.remoteType] ?? job.remoteType}</span>
                  </td>
                  <td class="salary-cell">
                    {salaryFmt}
                  </td>
                  <td>
                    <span class={`badge match-badge ${matchScore >= 50 ? 'match-high' : ''}`}>
                      {matchScore}%
                    </span>
                  </td>
                  <td>
                    {job.nextAction ? (
                      <div class={`next-action-cell ${isOverdue ? 'overdue' : ''}`}>
                        <span class="action-text">{job.nextAction}</span>
                        {job.nextActionDate && (
                          <time class="action-date" datetime={job.nextActionDate}>
                            {isOverdue ? 'Overdue · ' : ''}{formatDate(job.nextActionDate)}
                          </time>
                        )}
                      </div>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                  <td class="updated-cell">
                    <time datetime={new Date(job.updatedAt).toISOString()}>{formatDate(job.updatedAt)}</time>
                  </td>
                  <td class="text-right actions-cell">
                    <a href={`/jobs/${job.id}`} class="btn btn-sm">View</a>
                    <a href={`/jobs/${job.id}/edit`} class="btn btn-sm">Edit</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Layout>

<style>
  .jobs-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .header-row h1 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }
  .filter-inputs {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr auto;
    gap: 1rem;
    align-items: flex-end;
  }
  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .filter-field label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-mono);
    letter-spacing: var(--label-tracking);
  }
  .filter-checkboxes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }
  .filter-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .empty-container {
    text-align: center;
    padding: 3rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
  }
  .table-container {
    padding: 0;
    overflow-x: auto;
  }
  .jobs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }
  .jobs-table th {
    padding: 0.75rem 1rem;
    background-color: var(--bg-subtle);
    border-bottom: 2px solid var(--rule);
    font-size: 0.75rem;
    text-transform: uppercase;
    font-family: var(--font-mono);
    letter-spacing: var(--label-tracking);
    color: var(--text-muted);
    font-weight: 600;
  }
  .jobs-table td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }
  .jobs-table tr:last-child td {
    border-bottom: none;
  }
  .jobs-table tr:hover td {
    background-color: var(--bg-subtle);
  }
  .archived-row td {
    opacity: 0.6;
  }
  .job-cell-title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .title-link {
    font-weight: 600;
    color: var(--text-primary);
  }
  .company-sub {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .location-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  /* Stage reads as a column head in miniature: ink outline, never the "now" yellow. */
  .stage-badge {
    background: none;
    border-color: var(--rule);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .stage-badge.is-closed {
    border-color: var(--border-strong);
    color: var(--text-muted);
  }
  .match-badge {
    font-weight: 700;
    background: none;
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }
  .match-high {
    background-color: var(--primary);
    border-color: var(--primary);
    color: var(--text-inverse);
  }
  .next-action-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .next-action-cell.overdue .action-text,
  .next-action-cell.overdue .action-date {
    color: var(--danger);
    font-weight: 600;
  }
  .action-date {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .sort-link {
    color: inherit;
    min-height: 1.5rem;
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    white-space: nowrap;
  }
  .sort-link:hover,
  .sort-link.is-sorted {
    color: var(--text-primary);
    text-decoration: none;
  }
  .sort-indicator {
    display: inline-flex;
    min-width: 0.75rem;
  }
  .salary-cell,
  .updated-cell,
  .action-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .action-date {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .updated-cell {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .text-right {
    text-align: right;
  }
  .text-muted {
    color: var(--text-muted);
  }
  .actions-cell {
    white-space: nowrap;
  }
  @media (max-width: 1024px) {
    .filter-inputs {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .filter-inputs {
      grid-template-columns: 1fr;
    }
  }
</style>
