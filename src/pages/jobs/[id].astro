---
import Layout from '../../layouts/Layout.astro';
import config from '../../config';
import { getJobById } from '../../db/queries/jobs';
import Timeline from '../../components/Timeline.astro';
import Icon from '../../components/Icon.astro';
import Highlighter from '../../components/Highlighter';
import { formatSalary, REMOTE_LABELS } from '../../lib/format';
import { formatDate, todayInTz } from '../../lib/dates';
import { renderDescription } from '../../lib/highlights/html';

const { id } = Astro.params;
if (!id) return Astro.redirect('/jobs');

const job = await getJobById(id);
if (!job) return Astro.redirect('/jobs');

const warning = Astro.url.searchParams.get('warning');
const isArchived = Boolean(job.archivedAt);

const eventError = Astro.url.searchParams.get('eventError');
const salaryText = formatSalary(job);
const description = renderDescription(job, job.highlights);
const today = todayInTz();
const nextOverdue = !!job.nextActionDate && job.nextActionDate < today;
const nextToday = job.nextActionDate === today;
const PRIORITY_LABELS = ['None', 'Normal', 'High', 'Top'];

const currentStage = config.pipeline.stages.find((s) => s.id === job.status);
const stageLabel = currentStage ? currentStage.label : job.status;
---

<Layout title={`${job.title} at ${job.company}`}>
  <div class="job-detail">
    <div class="detail-top-nav">
      <a href="/jobs" class="back-link"><Icon name="arrow-left" /> Back to jobs</a>
      <div class="action-buttons">
        <a href={`/jobs/${job.id}/edit`} class="btn btn-sm">Edit</a>
        <a href={`/jobs/${job.id}/print?print=1`} class="btn btn-sm">Print job sheet</a>
        <a href={`/jobs/${job.id}/prep?print=1`} class="btn btn-sm">Print prep sheet</a>

        <form action={`/api/jobs/${job.id}`} method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this job posting?');">
          <input type="hidden" name="_method" value="DELETE" />
          <!-- Button triggers fetch or standard delete -->
          <button type="button" id="delete-btn" class="btn btn-sm btn-danger">Delete</button>
        </form>

        <form action={`/api/jobs/${job.id}`} method="POST" class="inline-form">
          <button type="button" id="archive-btn" class="btn btn-sm">
            {isArchived ? 'Unarchive' : 'Archive'}
          </button>
        </form>
      </div>
    </div>

    {warning && (
      <div class="warning-banner" role="alert">
        {warning}
      </div>
    )}

    {isArchived && (
      <div class="archived-banner">
        This job is archived.
      </div>
    )}

    <header class="job-header">
      <div class="pass-main">
        <div class="header-main">
          <div>
            <h1 class="job-title">{job.title}</h1>
            <p class="company-name">{job.company}</p>
          </div>
          {salaryText && <p class="salary-display">{salaryText}</p>}
        </div>

        <dl class="header-segs">
          <div class="header-seg">
            <dt>Mode</dt>
            <dd>{REMOTE_LABELS[job.remoteType] ?? job.remoteType}</dd>
          </div>
          {job.location && (
            <div class="header-seg header-seg-wide">
              <dt>Location</dt>
              <dd>{job.location}</dd>
            </div>
          )}
          {job.appliedAt && (
            <div class="header-seg">
              <dt>Applied</dt>
              <dd class="mono">{formatDate(job.appliedAt)}</dd>
            </div>
          )}
          {job.url && (
            <div class="header-seg">
              <dt>Posting</dt>
              <dd>
                <a href={job.url} target="_blank" rel="noopener noreferrer" class="posting-link">
                  Original posting <Icon name="external" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>

      <div class="pass-stub">
        {job.nextAction && (
          <div class:list={['next-action', { overdue: nextOverdue, today: nextToday }]}>
            <span class="label">Next</span>
            <p>
              <span class="next-action-text">{job.nextAction}</span>
              {job.nextActionDate && (
                <time class="next-action-date" datetime={job.nextActionDate}>
                  {nextOverdue ? 'Overdue · ' : nextToday ? 'Today · ' : 'Due '}
                  {formatDate(job.nextActionDate)}
                </time>
              )}
            </p>
          </div>
        )}

        <div class="header-controls no-print">
          <div class="control">
            <label for="job-status" class="label">Status</label>
            <select id="job-status" class="select" data-field="status">
              {!currentStage && <option value={job.status} selected>{stageLabel}</option>}
              {config.pipeline.stages.map((s) => (
                <option value={s.id} selected={s.id === job.status}>{s.label}</option>
              ))}
            </select>
          </div>
          <div class="control">
            <label for="job-priority" class="label">Priority</label>
            <select id="job-priority" class="select" data-field="priority">
              {PRIORITY_LABELS.map((label, i) => (
                <option value={i} selected={i === job.priority}>{label}</option>
              ))}
            </select>
          </div>
          <p class="control-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </header>

    {description.html ? (
      <Highlighter
        client:load
        jobId={job.id}
        initialHtml={description.html}
        baseHtml={description.baseHtml}
        text={description.text}
        highlights={job.highlights.map((h) => ({
          id: h.id,
          startOffset: h.startOffset,
          endOffset: h.endOffset,
          quote: h.quote,
          prefix: h.prefix,
          suffix: h.suffix,
          category: h.category,
          note: h.note,
        }))}
        orphanIds={description.orphaned.map((h) => h.id)}
        categories={config.highlights.categories}
      />
    ) : (
      <section class="card content-section">
        <h2 class="section-head">Job Description</h2>
        <p class="empty-state">No description yet. <a href={`/jobs/${job.id}/edit`}>Add one</a> to start highlighting.</p>
      </section>
    )}

    <div class="detail-lower">
      <Timeline jobId={job.id} events={job.events} error={eventError} />
      <section class="card sidebar-card" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="section-head">Skills</h2>
        {job.skills && job.skills.length > 0 ? (
          <div class="skills-tags">
            {job.skills.map((s) => (
              <span class="badge skill-badge">{s.name}</span>
            ))}
          </div>
        ) : (
          <p class="empty-state">No skills attached.</p>
        )}
      </section>
    </div>
  </div>

  <script define:vars={{ jobId: job.id, isArchived }}>
    // Handle Delete
    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to delete this job posting? This cannot be undone.')) return;
      try {
        const res = await fetch(`/api/jobs/${jobId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          window.location.href = '/jobs';
        } else {
          alert('Failed to delete job.');
        }
      } catch (err) {
        alert('An error occurred.');
      }
    });

    // Status and priority selects save immediately; a status change logs a timeline event, so reload.
    document.querySelectorAll('[data-field]').forEach((select) => {
      select.addEventListener('change', async () => {
        const field = select.dataset.field;
        const value = field === 'priority' ? Number(select.value) : select.value;
        const statusEl = document.querySelector('.control-status');
        select.disabled = true;
        try {
          const res = await fetch(`/api/jobs/${jobId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ [field]: value }),
          });
          if (!res.ok) throw new Error();
          if (field === 'status') {
            window.location.reload();
            return;
          }
          if (statusEl) statusEl.textContent = 'Saved';
        } catch {
          if (statusEl) statusEl.textContent = 'Could not save. Try again.';
        } finally {
          select.disabled = false;
        }
      });
    });

    // Handle Archive
    document.getElementById('archive-btn')?.addEventListener('click', async () => {
      try {
        const res = await fetch(`/api/jobs/${jobId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            archivedAt: isArchived ? null : new Date().toISOString(),
          }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update archive status.');
        }
      } catch (err) {
        alert('An error occurred.');
      }
    });
  </script>
</Layout>

<style>
  .job-detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .detail-top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .inline-form {
    display: inline;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .warning-banner {
    background-color: var(--warning-subtle);
    border: 1px solid var(--warning);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
  }
  .archived-banner {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
  }

  /* The job as a pass: identity above the perforation, what happens next below it. */
  .job-header {
    position: relative;
    background-color: var(--bg-surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
  }
  .pass-main {
    padding: 1.25rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .header-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem 1.5rem;
  }
  .job-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .company-name {
    margin-top: 0.3rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .salary-display {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .header-segs {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--border-subtle);
  }
  .header-seg {
    padding: 0.6rem 1.25rem 0 0;
    margin-right: 1.25rem;
    border-right: 1px solid var(--border-subtle);
    min-width: 0;
  }
  .header-seg:last-child {
    border-right: none;
    margin-right: 0;
  }
  .header-seg dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .header-seg dd {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .header-seg dd.mono {
    font-size: 0.8125rem;
  }
  .header-seg-wide {
    max-width: 28rem;
  }
  .posting-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
  }
  .pass-stub {
    --notch: 8px;
    position: relative;
    padding: 1rem 1.5rem 1.15rem;
    background-color: var(--bg-subtle);
    border-top: 2px dashed var(--border-strong);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .pass-stub::before,
  .pass-stub::after {
    content: "";
    position: absolute;
    top: calc(var(--notch) * -1 - 1px);
    width: calc(var(--notch) * 2);
    height: calc(var(--notch) * 2);
    border-radius: 50%;
    background-color: var(--bg-primary);
    border: 1px solid var(--rule);
    clip-path: inset(0 0 0 50%);
    left: calc(var(--notch) * -1 - 1px);
  }
  .pass-stub::after {
    left: auto;
    right: calc(var(--notch) * -1 - 1px);
    clip-path: inset(0 50% 0 0);
  }
  .next-action {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }
  .next-action p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .next-action-text {
    font-weight: 600;
  }
  .next-action-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .next-action.overdue .label,
  .next-action.overdue .next-action-text,
  .next-action.overdue .next-action-date {
    color: var(--danger);
  }
  .next-action.today .next-action-date {
    padding: 0.05rem 0.35rem;
    background-color: var(--alert);
    color: var(--alert-ink);
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
  .header-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .control {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 10rem;
  }
  .control-status {
    font-size: 0.8125rem;
    color: var(--text-muted);
    align-self: center;
  }
  .detail-lower {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .content-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .skill-badge {
    border-color: var(--rule);
    color: var(--text-primary);
    background: none;
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  @media (max-width: 768px) {
    .detail-lower {
      grid-template-columns: minmax(0, 1fr);
    }
    .pass-main,
    .pass-stub {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .job-title {
      font-size: 1.375rem;
    }
  }
</style>
