---
import Layout from '../../layouts/Layout.astro';
import config from '../../config';
import { getJobById } from '../../db/queries/jobs';
import Timeline from '../../components/Timeline.astro';
import { formatSalary, REMOTE_LABELS } from '../../lib/format';
import { formatDate, todayInTz } from '../../lib/dates';
import { renderDescription } from '../../lib/highlights/html';

const { id } = Astro.params;
if (!id) return Astro.redirect('/jobs');

const job = await getJobById(id);
if (!job) return Astro.redirect('/jobs');

const warning = Astro.url.searchParams.get('warning');
const isArchived = Boolean(job.archivedAt);

const eventError = Astro.url.searchParams.get('eventError');
const salaryText = formatSalary(job);
const description = renderDescription(job, job.highlights);
const today = todayInTz();
const nextOverdue = !!job.nextActionDate && job.nextActionDate < today;
const PRIORITY_LABELS = ['None', 'Normal', 'High', 'Top'];

const currentStage = config.pipeline.stages.find((s) => s.id === job.status);
const stageLabel = currentStage ? currentStage.label : job.status;
---

<Layout title={`${job.title} at ${job.company}`}>
  <div class="job-detail">
    <div class="detail-top-nav">
      <a href="/jobs" class="back-link">← Back to jobs</a>
      <div class="action-buttons">
        <a href={`/jobs/${job.id}/edit`} class="btn btn-sm">Edit</a>
        <a href={`/jobs/${job.id}/print?print=1`} class="btn btn-sm">Print job sheet</a>
        <a href={`/jobs/${job.id}/prep?print=1`} class="btn btn-sm">Print prep sheet</a>

        <form action={`/api/jobs/${job.id}`} method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this job posting?');">
          <input type="hidden" name="_method" value="DELETE" />
          <!-- Button triggers fetch or standard delete -->
          <button type="button" id="delete-btn" class="btn btn-sm btn-danger">Delete</button>
        </form>

        <form action={`/api/jobs/${job.id}`} method="POST" class="inline-form">
          <button type="button" id="archive-btn" class="btn btn-sm">
            {isArchived ? 'Unarchive' : 'Archive'}
          </button>
        </form>
      </div>
    </div>

    {warning && (
      <div class="warning-banner" role="alert">
        {warning}
      </div>
    )}

    {isArchived && (
      <div class="archived-banner">
        This job is archived.
      </div>
    )}

    <!-- Header Section -->
    <header class="job-header card">
      <div class="header-main">
        <div>
          <h1 class="job-title">{job.title}</h1>
          <div class="job-subtitle">
            <span class="company-name">{job.company}</span>
            {job.location && <span class="meta-item">📍 {job.location}</span>}
            <span class="meta-item badge">{REMOTE_LABELS[job.remoteType] ?? job.remoteType}</span>
          </div>
        </div>

        {salaryText && <div class="salary-display">{salaryText}</div>}
      </div>

      <div class="header-controls no-print">
        <div class="control">
          <label for="job-status">Status</label>
          <select id="job-status" class="select" data-field="status">
            {!currentStage && <option value={job.status} selected>{stageLabel}</option>}
            {config.pipeline.stages.map((s) => (
              <option value={s.id} selected={s.id === job.status}>{s.label}</option>
            ))}
          </select>
        </div>
        <div class="control">
          <label for="job-priority">Priority</label>
          <select id="job-priority" class="select" data-field="priority">
            {PRIORITY_LABELS.map((label, i) => (
              <option value={i} selected={i === job.priority}>{label}</option>
            ))}
          </select>
        </div>
        <p class="control-status" role="status" aria-live="polite"></p>
      </div>

      <div class="header-meta-row">
        {job.url && (
          <a href={job.url} target="_blank" rel="noopener noreferrer" class="posting-link">
            Original Posting ↗
          </a>
        )}
        {job.appliedAt && (
          <span class="applied-date">
            Applied {formatDate(job.appliedAt)}
          </span>
        )}
        {job.nextAction && (
          <div class={`next-action-pill ${nextOverdue ? 'overdue' : ''}`}>
            <strong>Next:</strong> {job.nextAction}
            {job.nextActionDate && (
              <span>
                ({nextOverdue ? 'overdue, ' : ''}due {formatDate(job.nextActionDate)})
              </span>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="job-grid">
      <!-- Main Content: Description -->
      <section class="card content-section">
        <h2>Job Description</h2>
        {description.html ? (
          <div class="description-body" set:html={description.html} />
        ) : (
          <p class="empty-state">No description provided.</p>
        )}
      </section>

      <!-- Sidebar: Skills & Timeline -->
      <aside class="sidebar-section">
        <!-- Skills -->
        <div class="card sidebar-card">
          <h3>Skills</h3>
          {job.skills && job.skills.length > 0 ? (
            <div class="skills-tags">
              {job.skills.map((s) => (
                <span class="badge skill-badge">{s.name}</span>
              ))}
            </div>
          ) : (
            <p class="empty-state">No skills attached.</p>
          )}
        </div>

        <Timeline jobId={job.id} events={job.events} error={eventError} />
      </aside>
    </div>
  </div>

  <script define:vars={{ jobId: job.id, isArchived }}>
    // Handle Delete
    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to delete this job posting? This cannot be undone.')) return;
      try {
        const res = await fetch(`/api/jobs/${jobId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          window.location.href = '/jobs';
        } else {
          alert('Failed to delete job.');
        }
      } catch (err) {
        alert('An error occurred.');
      }
    });

    // Status and priority selects save immediately; a status change logs a timeline event, so reload.
    document.querySelectorAll('[data-field]').forEach((select) => {
      select.addEventListener('change', async () => {
        const field = select.dataset.field;
        const value = field === 'priority' ? Number(select.value) : select.value;
        const statusEl = document.querySelector('.control-status');
        select.disabled = true;
        try {
          const res = await fetch(`/api/jobs/${jobId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ [field]: value }),
          });
          if (!res.ok) throw new Error();
          if (field === 'status') {
            window.location.reload();
            return;
          }
          if (statusEl) statusEl.textContent = 'Saved';
        } catch {
          if (statusEl) statusEl.textContent = 'Could not save. Try again.';
        } finally {
          select.disabled = false;
        }
      });
    });

    // Handle Archive
    document.getElementById('archive-btn')?.addEventListener('click', async () => {
      try {
        const res = await fetch(`/api/jobs/${jobId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            archivedAt: isArchived ? null : new Date().toISOString(),
          }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update archive status.');
        }
      } catch (err) {
        alert('An error occurred.');
      }
    });
  </script>
</Layout>

<style>
  .job-detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .detail-top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .inline-form {
    display: inline;
  }
  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .warning-banner {
    background-color: var(--warning-subtle);
    border: 1px solid var(--warning);
    color: var(--warning);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
  }
  .archived-banner {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
  }
  .job-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .header-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem 1rem;
  }
  .job-title {
    font-size: 1.75rem;
    font-weight: 700;
  }
  .job-subtitle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    color: var(--text-secondary);
  }
  .company-name {
    font-weight: 600;
    color: var(--text-primary);
  }
  .salary-display {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--primary);
    white-space: nowrap;
  }
  .header-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.875rem;
  }
  .posting-link {
    color: var(--primary);
    font-weight: 500;
  }
  .header-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .control {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 10rem;
  }
  .control label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .control-status {
    font-size: 0.8rem;
    color: var(--text-muted);
    align-self: center;
  }
  .next-action-pill.overdue {
    background-color: var(--danger-subtle);
    color: var(--danger);
  }
  .next-action-pill {
    background-color: var(--primary-subtle);
    color: var(--primary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  .job-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
  }
  .content-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .description-body {
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .description-body > :global(* + *) {
    margin-top: 0.75rem;
  }
  .description-body :global(h1),
  .description-body :global(h2),
  .description-body :global(h3),
  .description-body :global(h4) {
    border: none;
    padding: 0;
    margin-bottom: 0;
  }
  .description-body :global(ul),
  .description-body :global(ol) {
    padding-left: 1.4rem;
  }
  .description-body :global(h1),
  .description-body :global(h2),
  .description-body :global(h3) {
    font-size: 1rem;
    color: var(--text-primary);
  }
  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-badge {
    background-color: var(--primary-subtle);
    color: var(--primary);
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  @media (max-width: 768px) {
    .job-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
