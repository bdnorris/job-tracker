---
// One stroke icon set (12px grid, 1.6 stroke) so every glyph matches the board's drawn marks.
export type IconName = 'arrow-left' | 'arrow-up' | 'arrow-down' | 'plus' | 'external' | 'sort-asc' | 'sort-desc' | 'alert';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-left': 'M10.5 6h-9M5 2.5 1.5 6 5 9.5',
  'arrow-up': 'M6 10.5v-9M2.5 5 6 1.5 9.5 5',
  'arrow-down': 'M6 1.5v9M2.5 7 6 10.5 9.5 7',
  plus: 'M6 1.5v9M1.5 6h9',
  external: 'M5 2H2v8h8V7M7 2h3v3M10 2 5.5 6.5',
  'sort-asc': 'M2.5 7.5 6 4l3.5 3.5',
  'sort-desc': 'M2.5 4.5 6 8l3.5-3.5',
  alert: 'M6 1.5 11 10.5H1zM6 5v2.5M6 9v.01',
};
---

<svg class:list={['icon', className]} viewBox="0 0 12 12" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>

<style>
  .icon {
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: square;
    vertical-align: -0.05em;
  }
</style>
