---
import config from '../config';
import { EVENT_TYPE_LABELS } from '../lib/validation/event';
import type { getDashboardStats } from '../db/queries/jobs';

interface Props {
  stats: Awaited<ReturnType<typeof getDashboardStats>>;
}

const { stats } = Astro.props;
const tz = config.app.timezone;
const openStages = config.pipeline.stages.filter((s) => !s.closed);
const closedTotal = config.pipeline.stages
  .filter((s) => s.closed)
  .reduce((n, s) => n + (stats.countsByStage[s.id] ?? 0), 0);

const DAY_MS = 86400000;
const utcDay = (ymd: string) => {
  const [y, m, d] = ymd.split('-').map(Number);
  return Date.UTC(y, m - 1, d);
};

// Calendar dates (YYYY-MM-DD) are formatted in UTC so they never shift a day.
const shortDate = (ymd: string) =>
  new Date(utcDay(ymd)).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });

const daysLate = (ymd: string) => Math.round((utcDay(stats.today) - utcDay(ymd)) / DAY_MS);

const clock = (d: Date | string) =>
  new Date(d).toLocaleTimeString('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' });
const dayLabel = (d: Date | string) =>
  new Date(d).toLocaleDateString('en-US', { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric' });
const ymdInTz = (d: Date | string) => new Date(d).toLocaleDateString('en-CA', { timeZone: tz });

function untilLabel(d: Date | string) {
  const days = Math.round((utcDay(ymdInTz(d)) - utcDay(stats.today)) / DAY_MS);
  if (days <= 0) return 'Today';
  if (days === 1) return 'Tomorrow';
  return `In ${days} days`;
}

const [nextInterview, ...laterInterviews] = stats.upcomingInterviews;
const now = new Date();
const clockTz = (d: Date) =>
  d.toLocaleTimeString('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
---

<section class="departures" aria-label="Dashboard">
  <div class="dep-inner">
    <div class="dep-pipeline">
      <h2 class="dep-heading">Pipeline</h2>
      <dl class="dep-tiles" aria-label="Jobs per stage">
        {openStages.map((stage) => (
          <div class="dep-tile">
            <dt>{stage.label}</dt>
            <dd>{stats.countsByStage[stage.id] ?? 0}</dd>
          </div>
        ))}
        <div class="dep-tile is-closed">
          <dt>Closed</dt>
          <dd>{closedTotal}</dd>
        </div>
      </dl>
      <dl class="dep-tiles dep-window" aria-label="Recent applications">
        <div class="dep-tile">
          <dt>Applied, 7 days</dt>
          <dd>{stats.appliedLast7}</dd>
        </div>
        <div class="dep-tile">
          <dt>Applied, 30 days</dt>
          <dd>{stats.appliedLast30}</dd>
        </div>
      </dl>
    </div>

    <div class="dep-panel dep-actions">
      <div class="dep-panel-head">
        <h2 class="dep-heading">Next actions due</h2>
        <span class="dep-count">
          <time datetime={now.toISOString()}>{dayLabel(now)} · {clockTz(now)}</time>
        </span>
      </div>
      {stats.dueActions.length === 0 ? (
        <p class="dep-empty">Nothing overdue or due today.</p>
      ) : (
        <table class="dep-table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Action</th>
              <th scope="col">Job</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {stats.dueActions.map((a) => {
              const late = a.overdue ? daysLate(a.nextActionDate!) : 0;
              return (
                <tr class={a.overdue ? 'is-overdue' : 'is-now'}>
                  <td class="dep-date">
                    <time datetime={a.nextActionDate ?? undefined}>{shortDate(a.nextActionDate!)}</time>
                  </td>
                  <td class="dep-action" title={a.nextAction || undefined}>
                    <a href={`/jobs/${a.id}`}>{a.nextAction || 'Next action'}</a>
                  </td>
                  <td class="dep-job" title={`${a.company} · ${a.title}`}>
                    <span class="dep-company">{a.company}</span>
                    <span class="dep-title">{a.title}</span>
                  </td>
                  <td class="dep-status">
                    {a.overdue ? (
                      <span>Overdue <span class="dep-late">{late}d</span></span>
                    ) : (
                      <span class="dep-now">Today</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>

    <div class="dep-panel dep-interviews">
      <div class="dep-panel-head">
        <h2 class="dep-heading">Upcoming interviews</h2>
        <span class="dep-count">{stats.upcomingInterviews.length}</span>
      </div>
      {!nextInterview ? (
        <p class="dep-empty">No interviews scheduled.</p>
      ) : (
        <div class="dep-next">
          <p class="dep-clock">
            <time datetime={new Date(nextInterview.occurredAt).toISOString()}>
              <span class="dep-clock-time">{clock(nextInterview.occurredAt)}</span>
              <span class="dep-clock-day">{dayLabel(nextInterview.occurredAt)}</span>
            </time>
          </p>
          <a class="dep-next-title" href={`/jobs/${nextInterview.jobId}#event-${nextInterview.id}`}>
            {nextInterview.title}
          </a>
          <p class="dep-next-job">{nextInterview.company} · {nextInterview.jobTitle}</p>
          <p class="dep-next-meta">
            <span>{EVENT_TYPE_LABELS[nextInterview.type]}</span>
            <span>{untilLabel(nextInterview.occurredAt)}</span>
          </p>
          {laterInterviews.length > 0 && (
            <ul class="dep-later">
              {laterInterviews.map((e) => (
                <li>
                  <time datetime={new Date(e.occurredAt).toISOString()}>{dayLabel(e.occurredAt)}</time>
                  <a href={`/jobs/${e.jobId}#event-${e.id}`}>{e.title}</a>
                  <span>{e.company}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .departures {
    --focus: var(--alert);
    background-color: var(--shell-bg);
    color: var(--shell-text);
    border-bottom: 1px solid var(--shell-line);
  }
  .departures a {
    color: var(--shell-text);
  }
  .dep-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 1.5rem 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 23rem) minmax(0, 1fr) minmax(260px, 22rem);
    grid-template-areas: "pipeline actions interviews";
    gap: 1rem 1.25rem;
    align-items: start;
  }
  .dep-pipeline {
    grid-area: pipeline;
    display: flex;
    flex-direction: column;
  }
  .dep-pipeline .dep-heading {
    grid-column: 1 / -1;
  }
  .dep-actions {
    grid-area: actions;
  }
  .dep-interviews {
    grid-area: interviews;
  }
  .dep-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--shell-text);
  }

  /* Pipeline tiles */
  .dep-tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background-color: var(--shell-line);
    border: 1px solid var(--shell-line);
    margin-top: 0.75rem;
  }
  .dep-tile {
    background-color: var(--shell-bg);
    padding: 0.7rem 0.85rem 0.8rem;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    min-width: 0;
  }
  .dep-tile dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--shell-muted);
  }
  .dep-tile dd {
    font-family: var(--font-mono);
    font-size: 2.75rem;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .dep-tile.is-closed dd {
    color: var(--shell-muted);
  }
  .dep-window {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0.5rem;
  }
  .dep-window .dep-tile dd {
    font-size: 1.75rem;
    color: var(--shell-muted);
  }

  /* Panels */
  .dep-panel {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--shell-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    min-width: 0;
  }
  .dep-panel-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 1rem;
    background-color: var(--shell-raised);
  }
  .dep-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--shell-muted);
  }
  .dep-empty {
    padding: 1.1rem 1rem;
    color: var(--shell-muted);
    font-size: 0.875rem;
  }

  /* Departures table */
  .dep-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .dep-table th:nth-child(1) {
    width: 6rem;
  }
  .dep-table th:nth-child(2) {
    width: 42%;
  }
  .dep-table th:nth-child(4) {
    width: 7.75rem;
  }
  /* One line per departure; the full text stays in the link and title. */
  .dep-action,
  .dep-job {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dep-table th {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--shell-muted);
    text-align: left;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--shell-line);
  }
  .dep-table td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--shell-line);
    vertical-align: baseline;
  }
  .dep-table tr:last-child td {
    border-bottom: none;
  }
  .dep-date,
  .dep-status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dep-date {
    width: 6.5rem;
  }
  .dep-status {
    width: 9rem;
  }
  .dep-action a {
    font-weight: 600;
  }
  .dep-job {
    color: var(--shell-muted);
  }
  .dep-company {
    color: var(--shell-text);
  }
  .dep-title::before {
    content: " · ";
  }
  .dep-late {
    margin-left: 0.25rem;
    opacity: 0.85;
  }
  .is-overdue .dep-date,
  .is-overdue .dep-status {
    color: var(--shell-danger);
  }
  /* Due today: the lit row. */
  .is-now td {
    background-color: var(--alert);
    color: var(--alert-ink);
    border-bottom-color: var(--alert);
  }
  .is-now a,
  .is-now .dep-company,
  .is-now .dep-job {
    color: var(--alert-ink);
  }
  .is-now {
    --focus: var(--alert-ink);
  }
  .dep-now {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    background-color: var(--alert-ink);
    color: var(--alert);
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  /* Next interview: the clock reads first. */
  .dep-next {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .dep-clock time {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
  }
  .dep-clock-time {
    font-family: var(--font-mono);
    font-size: 3.5rem;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .dep-clock-day {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--shell-muted);
  }
  .dep-next-title {
    margin-top: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .dep-next-job {
    color: var(--shell-muted);
    font-size: 0.875rem;
  }
  .dep-next-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--shell-line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--shell-muted);
  }
  .dep-later {
    list-style: none;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
  }
  .dep-later li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 0.75rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--shell-line);
    font-size: 0.8125rem;
  }
  .dep-later time {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--shell-muted);
  }
  .dep-later span {
    color: var(--shell-muted);
  }

  @media (max-width: 960px) {
    .dep-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "pipeline" "actions" "interviews";
    }
  }
  @media (max-width: 720px) {
    .dep-inner {
      padding: 1rem;
      gap: 1rem;
    }
    .dep-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .dep-table tr {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.15rem 0.75rem;
      padding: 0.65rem 1rem;
      border-bottom: 1px solid var(--shell-line);
    }
    .dep-table tr:last-child {
      border-bottom: none;
    }
    .dep-table tr.is-now {
      background-color: var(--alert);
    }
    .dep-table td {
      padding: 0;
      border: none;
      width: auto;
    }
    .dep-action,
    .dep-job {
      white-space: normal;
    }
    .dep-action,
    .dep-job {
      grid-column: 1 / -1;
    }
    .dep-action {
      order: 3;
    }
    .dep-job {
      order: 4;
    }
    .dep-status {
      text-align: right;
    }
  }
</style>
