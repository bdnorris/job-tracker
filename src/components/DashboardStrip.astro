---
import config from '../config';
import { formatDate, formatDateTime } from '../lib/dates';
import { EVENT_TYPE_LABELS } from '../lib/validation/event';
import type { getDashboardStats } from '../db/queries/jobs';

interface Props {
  stats: Awaited<ReturnType<typeof getDashboardStats>>;
}

const { stats } = Astro.props;
const openStages = config.pipeline.stages.filter((s) => !s.closed);
const closedTotal = config.pipeline.stages
  .filter((s) => s.closed)
  .reduce((n, s) => n + (stats.countsByStage[s.id] ?? 0), 0);
---

<section class="dashboard-strip" aria-label="Dashboard">
  <div class="strip-stats">
    <dl class="stat-group" aria-label="Jobs per stage">
      {openStages.map((stage) => (
        <div class="stat">
          <dt>{stage.label}</dt>
          <dd>{stats.countsByStage[stage.id] ?? 0}</dd>
        </div>
      ))}
      {closedTotal > 0 && (
        <div class="stat stat-muted">
          <dt>Closed</dt>
          <dd>{closedTotal}</dd>
        </div>
      )}
    </dl>
    <dl class="stat-group" aria-label="Recent applications">
      <div class="stat">
        <dt>Applied, 7 days</dt>
        <dd>{stats.appliedLast7}</dd>
      </div>
      <div class="stat">
        <dt>Applied, 30 days</dt>
        <dd>{stats.appliedLast30}</dd>
      </div>
    </dl>
  </div>

  <div class="strip-lists">
    <div class="strip-list">
      <h2>Next actions due</h2>
      {stats.dueActions.length === 0 ? (
        <p class="strip-empty">Nothing overdue or due today.</p>
      ) : (
        <ul>
          {stats.dueActions.map((a) => (
            <li class={a.overdue ? 'overdue' : ''}>
              <a href={`/jobs/${a.id}`}>{a.nextAction || 'Next action'}</a>
              <span class="strip-meta">
                {a.title} · {a.company} ·{' '}
                <time datetime={a.nextActionDate ?? undefined}>
                  {a.overdue ? `Overdue (${formatDate(a.nextActionDate!)})` : 'Today'}
                </time>
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="strip-list">
      <h2>Upcoming interviews</h2>
      {stats.upcomingInterviews.length === 0 ? (
        <p class="strip-empty">No interviews scheduled.</p>
      ) : (
        <ul>
          {stats.upcomingInterviews.map((e) => (
            <li>
              <a href={`/jobs/${e.jobId}#event-${e.id}`}>{e.title}</a>
              <span class="strip-meta">
                {EVENT_TYPE_LABELS[e.type]} · {e.jobTitle} · {e.company} ·{' '}
                <time datetime={new Date(e.occurredAt).toISOString()}>{formatDateTime(e.occurredAt)}</time>
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .dashboard-strip {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
  }
  .strip-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .stat-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .stat-group + .stat-group {
    padding-left: 2rem;
    border-left: 1px solid var(--border-subtle);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
  }
  .stat dt {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .stat dd {
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .stat-muted dd {
    color: var(--text-secondary);
  }
  .strip-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }
  .strip-list h2 {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }
  .strip-list ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .strip-list li {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
  }
  .strip-list li.overdue time {
    color: var(--danger);
    font-weight: 600;
  }
  .strip-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .strip-empty {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @media (max-width: 768px) {
    .strip-lists {
      grid-template-columns: 1fr;
    }
    .stat-group + .stat-group {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
